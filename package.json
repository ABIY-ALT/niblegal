    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "clsx": "^2.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "prisma": "^7.8.0",
    "tailwind-merge": "^3.6.0",
